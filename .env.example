# Plantilla de variables de entorno. Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
#
# Las variables EXPO_PUBLIC_* se inyectan en el bundle del cliente (no poner secretos aquí).

# URL base del backend FastAPI.
# En desarrollo con dispositivo físico usar la IP de la máquina en la red local
# (no localhost: el móvil no resuelve el localhost del PC), p.ej. http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=

# Firebase (SDK Web). Valores en la consola de Firebase:
# Configuración del proyecto > Tus apps > app web > SDK setup and configuration.
# No son secretos: van en el bundle del cliente por diseño. Lo que protege el
# proyecto son las reglas de seguridad de Firebase y los dominios autorizados,
# no ocultar estas claves.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=